   explain:"Reunir firmas para que un gobernante elegido salga antes de terminar su periodo es la Revocatoria del Mandato."},
  {case:"Los estudiantes y padres de un colegio piden un espacio público con el Concejo Municipal para exponer directamente su inquietud sobre el estado de la vía de acceso al colegio.",
   q:"¿Qué mecanismo están usando?",
   options:["Cabildo Abierto","Plebiscito","Revocatoria del Mandato","Referendo"], correct:0,
   explain:"Una reunión pública y directa con el Concejo, donde la comunidad expone sus inquietudes, es un Cabildo Abierto."},
  {case:"El gobierno nacional necesita saber si la mayoría del país apoya un cambio profundo en la forma de elegir al Congreso, antes de decidir si lo lleva a cabo.",
   q:"¿Qué mecanismo se debe usar para consultar directamente a la gente?",
   options:["Plebiscito","Cabildo Abierto","Consulta Popular","Control Fiscal"], correct:0,
   explain:"Preguntar a todo el país sobre una decisión trascendental del gobierno es un Plebiscito."},
  {case:"En un municipio, los ciudadanos votan directamente para decidir si aprueban o rechazan una norma sobre el manejo del agua potable.",
   q:"¿Qué mecanismo describe esta votación?",
   options:["Referendo","Revocatoria del Mandato","Veeduría","Plebiscito"], correct:0,
   explain:"Aprobar o rechazar una norma específica mediante votación directa es un Referendo."}
];

const QUIZ_FINAL = [
  {case:"Un salón decide sus reglas votando entre todos y respetando a quien piense diferente.",
   q:"¿Qué forma de gobierno es?", options:["Democracia","Autoritarismo","Monarquía","Anarquía"], correct:0,
   explain:"Decidir entre todos y respetar a la minoría es propio de la democracia."},
  {case:"En el colegio, un estudiante siente que no lo dejan participar y busca ayuda con quien defiende los derechos de todos.",
   q:"¿A quién debería acudir?", options:["Al Personero Estudiantil","Al Contralor Estudiantil","Al Rector únicamente","A la Procuraduría"], correct:0,
   explain:"El Personero Estudiantil defiende los derechos y la participación de todos los estudiantes."},
  {case:"Un ciudadano quiere saber cada cuánto se eligen alcaldes, gobernadores, presidente y congresistas.",
   q:"¿Cada cuántos años se eligen, en general, estos cargos?", options:["4 años","6 años","2 años","10 años"], correct:0,
   explain:"En Colombia, los cargos de elección popular territoriales y nacionales tienen periodos de 4 años."},
  {case:"Se descubre que el dinero destinado a una obra pública desapareció.",
   q:"¿Qué organismo investiga este caso?", options:["La Contraloría (control fiscal)","La Procuraduría (control disciplinario)","El Concejo Municipal","El Personero"], correct:0,
   explain:"La Contraloría investiga el buen uso del dinero público: es el control fiscal."},
  {case:"Se descubre que un funcionario no cumplió con sus deberes y actuó de forma irresponsable en su cargo.",
   q:"¿Qué organismo investiga este caso?", options:["La Procuraduría (control disciplinario)","La Contraloría (control fiscal)","La Veeduría ciudadana","El Cabildo Abierto"], correct:0,
   explain:"La Procuraduría investiga y sanciona el incumplimiento de deberes de los funcionarios."},
  {case:"Un grupo de ciudadanos recoge firmas porque su alcalde no ha cumplido nada de lo prometido.",
   q:"¿Cómo se llama este mecanismo de participación?", options:["Revocatoria del Mandato","Cabildo Abierto","Referendo","Control Fiscal"], correct:0,
   explain:"Sacar a un gobernante de su cargo mediante firmas ciudadanas es la Revocatoria del Mandato."},
  {case:"En 1991, Colombia adoptó un nuevo documento que amplió las herramientas de participación ciudadana, más allá de solo votar por representantes.",
   q:"¿Qué documento es?", options:["La Constitución Política","El Manual de Convivencia","El Código Fiscal","El Plan de Desarrollo"], correct:0,
   explain:"La Constitución Política de 1991 amplió los mecanismos de participación ciudadana en Colombia."},
  {case:"Un estudiante comparte una noticia falsa sobre una decisión del colegio y varias familias se confunden por eso.",
   q:"¿Cómo se llama esta situación?", options:["Desinformación (fake news)","Control disciplinario","Cabildo Abierto","Estado Social de Derecho"], correct:0,
   explain:"Compartir información falsa que confunde a las personas se llama desinformación."}
];

/* ============ STATE ============ */
const completed = {plaza:false, colegio:false, palacio:false, torre:false, casa:false, final:false};

/* ============ RENDER MAP ============ */
function shuffle(arr){ return arr.map(v=>[Math.random(),v]).sort((a,b)=>a[0]-b[0]).map(v=>v[1]); }

function renderStamps(){
  const el = document.getElementById('stamps');
  el.innerHTML = STATIONS.map(s => `<span class="stamp ${completed[s.id]?'done':''}" title="${s.title}">${completed[s.id]?'✓':''}</span>`).join('');
}

function renderBoard(){
  const board = document.getElementById('board');
  board.innerHTML = STATIONS.map(s => `
    <button class="station" data-id="${s.id}">
      <span class="station-icon">${ICONS[s.icon]}</span>
      <span class="station-text">
        <span class="station-title">${s.title}</span>
        <span class="station-desc">${s.desc}</span>
      </span>
      <span class="station-mark">${completed[s.id] ? '✓' : ''}</span>
    </button>
  `).join('');
  board.querySelectorAll('.station').forEach(btn=>{
    btn.addEventListener('click', ()=> openStation(btn.dataset.id));
  });
}

function openStation(id){
  document.getElementById('mapView').classList.add('hidden');
  document.getElementById('stationView').classList.remove('hidden');
  const content = document.getElementById('stationContent');
  if(id==='plaza') buildScenarioStation(content,'plaza','Plaza de la Democracia','Tipos de gobierno y valores democráticos','Lee cada caso y elige la mejor respuesta.', shuffleQuiz(QUIZ_PLAZA));
  if(id==='colegio') buildMatchingStation(content);
  if(id==='palacio') buildPalacioStation(content);
  if(id==='torre') buildSortingStation(content);
  if(id==='casa') buildCasaStation(content);
  if(id==='final') buildScenarioStation(content,'final','Meta: repaso final','Un poco de todo lo aprendido en la ciudad','Este repaso mezcla todos los temas de la ciudad.', shuffleQuiz(QUIZ_FINAL));
  window.scrollTo({top:0, behavior:'smooth'});
}

function shuffleQuiz(list){
  return shuffle(list).map(item=>{
    const orderIdx = shuffle(item.options.map((o,i)=>i));
    return {...item, options:orderIdx.map(i=>item.options[i]), correct: orderIdx.indexOf(item.correct)};
  });
}

document.getElementById('backBtn').addEventListener('click', ()=>{
  document.getElementById('stationView').classList.add('hidden');
  document.getElementById('mapView').classList.remove('hidden');
  renderBoard();
  renderStamps();
  window.scrollTo({top:0, behavior:'smooth'});
});

/* ============ SCENARIO QUIZ ============ */
function buildScenarioStation(container, id, title, kicker, instructions, items){
  let idx = 0, score = 0;
  render();
  function render(){
    if(idx >= items.length){ showResult(); return; }
    const item = items[idx];
    container.innerHTML = `
      <p class="kicker">${kicker}</p>
      <h2>${title}</h2>
      <p class="instructions">${instructions}</p>
      <p class="progress-line">Pregunta ${idx+1} de ${items.length} · Aciertos: ${score}</p>
      <div class="case-box">${item.case}</div>
      <p class="question-text">${item.q}</p>
      <div class="options" id="opts"></div>
    `;
    const optsEl = container.querySelector('#opts');
    item.options.forEach((opt, i)=>{
      const b = document.createElement('button');
      b.className='option-btn';
      b.textContent = opt;
      b.addEventListener('click', ()=>{
        const buttons = optsEl.querySelectorAll('.option-btn');
        buttons.forEach(bb=>bb.disabled=true);
        if(i === item.correct){ b.classList.add('correct'); score++; }
        else{
          b.classList.add('incorrect');
          buttons[item.correct].classList.add('correct');
        }
        const explain = document.createElement('div');
        explain.className='explain';
        explain.textContent = item.explain;
        container.querySelector('.options').after(explain);
        const next = document.createElement('button');
        next.className='next-btn';
        next.textContent = (idx === items.length-1) ? 'Ver resultado' : 'Siguiente';
        next.addEventListener('click', ()=>{ idx++; render(); });
        explain.after(next);
      });
      optsEl.appendChild(b);
    });
  }
  function showResult(){
    completed[id] = true; renderStamps();
    container.innerHTML = `
      <p class="kicker">${kicker}</p>
      <h2>${title}</h2>
      <div class="result-box">
        <div class="result-score">${score} / ${items.length}</div>
        <p>${score===items.length ? '¡Excelente! Dominas este tema.' : score >= Math.ceil(items.length*0.6) ? '¡Bien hecho! Repasa lo que falló y sigue.' : 'Vale la pena repasar este tema una vez más.'}</p>
        <button class="primary-btn" id="retryBtn">Intentar de nuevo</button>
      </div>
    `;
    container.querySelector('#retryBtn').addEventListener('click', ()=>{
      openStation(id);
    });
  }
}

/* ============ MATCHING (COLEGIO) ============ */
function buildMatchingStation(container){
  const pairs = MATCH_COLEGIO;
  const terms = shuffle(pairs.map((p,i)=>({text:p.term, i})));
  const defs = shuffle(pairs.map((p,i)=>({text:p.def, i})));
  let selectedTerm = null, matchedCount = 0;

  container.innerHTML = `
    <p class="kicker">El Colegio</p>
    <h2>Gobierno escolar: cargos y funciones</h2>
    <p class="instructions">Toca un cargo y luego toca la función que le corresponde.</p>
    <p class="progress-line" id="matchProgress">Parejas encontradas: 0 / ${pairs.length}</p>
    <div class="match-wrap">
      <div class="match-col" id="termCol"></div>
      <div class="match-col" id="defCol"></div>
    </div>
  `;
  const termCol = container.querySelector('#termCol');
  const defCol = container.querySelector('#defCol');

  terms.forEach(t=>{
    const el = document.createElement('button');
    el.className='match-item'; el.textContent=t.text; el.dataset.i=t.i;
    el.addEventListener('click', ()=>{
      if(el.classList.contains('matched')) return;
      termCol.querySelectorAll('.match-item').forEach(x=>x.classList.remove('selected'));
      el.classList.add('selected');
      selectedTerm = el;
    });
    termCol.appendChild(el);
  });
  defs.forEach(d=>{
    const el = document.createElement('button');
    el.className='match-item'; el.textContent=d.text; el.dataset.i=d.i;
    el.addEventListener('click', ()=>{
      if(el.classList.contains('matched') || !selectedTerm) return;
      if(String(el.dataset.i) === String(selectedTerm.dataset.i)){
        el.classList.add('matched'); selectedTerm.classList.add('matched');
        selectedTerm.classList.remove('selected');
        matchedCount++;
        container.querySelector('#matchProgress').textContent = `Parejas encontradas: ${matchedCount} / ${pairs.length}`;
        selectedTerm = null;
        if(matchedCount === pairs.length){
          completed.colegio = true; renderStamps();
          const done = document.createElement('div');
          done.className='result-box';
          done.innerHTML = `<p>¡Completaste todas las parejas! 🎉</p><button class="primary-btn" id="retryColegio">Jugar de nuevo</button>`;
          container.appendChild(done);
          done.querySelector('#retryColegio').addEventListener('click', ()=> buildMatchingStation(container));
        }
      } else {
        el.classList.add('wrong'); selectedTerm.classList.add('wrong');
        setTimeout(()=>{ el.classList.remove('wrong'); selectedTerm.classList.remove('wrong','selected'); selectedTerm=null; }, 350);
      }
    });
    defCol.appendChild(el);
  });
}

/* ============ PALACIO: ordering + V/F ============ */
function buildPalacioStation(container){
  const items = shuffle(ORDER_PALACIO.map((o,i)=>({...o, id:i})));
  let placed = [];

  render();
  function render(){
    container.innerHTML = `
      <p class="kicker">Palacio de Gobierno</p>
      <h2>Cargos de elección popular</h2>
      <p class="instructions">Toca los niveles de gobierno en orden, del más cercano (la escuela) al más amplio (la nación).</p>
      <div class="order-pool" id="pool"></div>
      <div class="order-slots" id="slots"></div>
      <div class="order-feedback" id="orderFeedback"></div>
    `;
    const pool = container.querySelector('#pool');
    const slots = container.querySelector('#slots');
    for(let i=0;i<ORDER_PALACIO.length;i++){
      const slot = document.createElement('div');
      slot.className='order-slot';
      slot.textContent = placed[i] ? placed[i].label : `Puesto ${i+1}`;
      if(placed[i]) slot.classList.add('filled');
      slots.appendChild(slot);
    }
    items.forEach(it=>{
      const chip = document.createElement('button');
      chip.className='order-chip'; chip.textContent = it.label;
      if(placed.find(p=>p && p.id===it.id)) chip.disabled = true;
      chip.addEventListener('click', ()=>{
        if(placed.length < ORDER_PALACIO.length){
          placed.push(it); render();
          if(placed.length === ORDER_PALACIO.length) checkOrder();
        }
      });
      pool.appendChild(chip);
    });
  }
  function checkOrder(){
    const fb = container.querySelector('#orderFeedback');
    const correct = placed.every((p,i)=> p.level === i+1);
    if(correct){
      fb.style.color='var(--good)';
      fb.textContent = '¡Orden correcto! De la escuela a la nación, el poder se organiza en escalones.';
      setTimeout(()=> startVF(container), 1400);
    } else {
      fb.style.color='var(--bad)';
      fb.textContent = 'Ese orden no es correcto. Vuelve a intentarlo.';
      setTimeout(()=>{ placed=[]; render(); }, 1300);
    }
  }
}

function startVF(container){
  const items = shuffle(VF_PALACIO);
  let idx = 0, score = 0;
  render();
  function render(){
    if(idx >= items.length){ finish(); return; }
    const item = items[idx];
    container.innerHTML = `
      <p class="kicker">Palacio de Gobierno</p>
      <h2>Verdadero o falso</h2>
      <p class="progress-line">Afirmación ${idx+1} de ${items.length} · Aciertos: ${score}</p>
      <div class="case-box">${item.text}</div>
      <div class="options" id="vfOpts">
        <button class="option-btn" data-v="true">Verdadero</button>
        <button class="option-btn" data-v="false">Falso</button>
      </div>
    `;
    container.querySelectorAll('#vfOpts .option-btn').forEach(b=>{
      b.addEventListener('click', ()=>{
        const val = b.dataset.v === 'true';
        container.querySelectorAll('#vfOpts .option-btn').forEach(x=>x.disabled=true);
        if(val === item.answer){ b.classList.add('correct'); score++; }
        else{
          b.classList.add('incorrect');
          container.querySelectorAll('#vfOpts .option-btn').forEach(x=>{ if((x.dataset.v==='true')===item.answer) x.classList.add('correct'); });
        }
        const explain = document.createElement('div');
        explain.className='explain'; explain.textContent = item.explain;
        container.querySelector('#vfOpts').after(explain);
        const next = document.createElement('button');
        next.className='next-btn';
        next.textContent = idx===items.length-1 ? 'Ver resultado' : 'Siguiente';
        next.addEventListener('click', ()=>{ idx++; render(); });
        explain.after(next);
      });
    });
  }
  function finish(){
    completed.palacio = true; renderStamps();
    container.innerHTML = `
      <p class="kicker">Palacio de Gobierno</p>
      <h2>Cargos de elección popular</h2>
      <div class="result-box">
        <div class="result-score">${score} / ${items.length}</div>
        <p>Ya conoces cómo se organizan y controlan los cargos de elección popular.</p>
        <button class="primary-btn" id="retryPalacio">Volver a empezar</button>
      </div>
    `;
    container.querySelector('#retryPalacio').addEventListener('click', ()=> buildPalacioStation(container));
  }
}

/* ============ TORRE: sorting ============ */
function buildSortingStation(container){
  const pool = shuffle(SORT_TORRE.items.map((it,i)=>({...it, id:i})));
  const binState = {}; SORT_TORRE.bins.forEach(b=> binState[b.id]=[]);
  let placedCount = 0, selected = null;

  render();
  function render(){
    container.innerHTML = `
      <p class="kicker">Torre de Control</p>
      <h2>Organismos de control del Estado</h2>
      <p class="instructions">Toca una situación y luego toca el organismo que debe intervenir.</p>
      <div class="sort-bins" id="bins"></div>
      <div class="sort-pool" id="sortPool"></div>
    `;
    const binsEl = container.querySelector('#bins');
    SORT_TORRE.bins.forEach(b=>{
      const div = document.createElement('div');
      div.className='sort-bin'; div.dataset.bin=b.id;
      div.innerHTML = `<h4>${b.label}</h4>` + binState[b.id].map(t=>`<div class="placed">${t}</div>`).join('');
      div.addEventListener('click', ()=>{
        if(!selected) return;
        if(selected.bin === b.id){
          binState[b.id].push(selected.text);
          pool.splice(pool.findIndex(p=>p.id===selected.id),1);
          placedCount++; selected=null; render();
          if(placedCount === SORT_TORRE.items.length) finish();
        } else {
          div.classList.add('wrong');
          setTimeout(()=> div.classList.remove('wrong'), 350);
        }
      });
      binsEl.appendChild(div);
    });
    const poolEl = container.querySelector('#sortPool');
    pool.forEach(it=>{
      const chip = document.createElement('button');
      chip.className='sort-chip'; chip.textContent = it.text;
      chip.addEventListener('click', ()=>{
        container.querySelectorAll('.sort-chip').forEach(c=>c.classList.remove('selected'));
        chip.classList.add('selected');
        selected = it;
      });
      poolEl.appendChild(chip);
    });
  }
  function finish(){
    completed.torre = true; renderStamps();
    const done = document.createElement('div');
    done.className='result-box';
    done.innerHTML = `<p>¡Clasificaste todas las situaciones correctamente! 🕵️</p><button class="primary-btn" id="retryTorre">Jugar de nuevo</button>`;
    container.appendChild(done);
    done.querySelector('#retryTorre').addEventListener('click', ()=> buildSortingStation(container));
  }
}

/* ============ CASA: flashcards + quiz ============ */
function buildCasaStation(container){
  const cards = FLASH_CASA;
  let idx = 0, flipped = false;
  render();
  function render(){
    container.innerHTML = `
      <p class="kicker">Casa de la Participación</p>
      <h2>Mecanismos de participación ciudadana</h2>
      <p class="instructions">Lee la situación, piensa el nombre del mecanismo y toca la tarjeta para ver la respuesta.</p>
      <div class="flash-wrap">
        <div class="flash-card" id="card">${flipped ? `<span class="back-label">${cards[idx].back}</span>` : cards[idx].front}</div>
        <div class="flash-nav">
          <button id="prevBtn" ${idx===0?'disabled':''}>← Anterior</button>
          <span class="flash-count">${idx+1} / ${cards.length}</span>
          <button id="nextBtn">${idx===cards.length-1 ? 'Practicar' : 'Siguiente →'}</button>
        </div>
      </div>
    `;
    container.querySelector('#card').addEventListener('click', ()=>{ flipped=!flipped; render(); });
    container.querySelector('#prevBtn').addEventListener('click', ()=>{ idx=Math.max(0,idx-1); flipped=false; render(); });
    container.querySelector('#nextBtn').addEventListener('click', ()=>{
      if(idx===cards.length-1){ buildScenarioStation(container,'casa','Casa de la Participación','Mecanismos de participación ciudadana','Ahora responde estas preguntas con tus propias palabras.', shuffleQuiz(QUIZ_CASA)); }
      else{ idx++; flipped=false; render(); }
    });
  }
}

/* ============ INIT ============ */
renderBoard();
renderStamps();
</script>
